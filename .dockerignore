# Dependencies & build output (rebuilt inside the image)
node_modules
dist

# Secrets — never copy into the build context
.env
.env.*

# VCS & tooling
.git
.gitignore
.vscode
.replit
.claude
.superpowers
.prettierrc.json

# Local-only / generated artifacts
generated_contracts
server/templates
*.log

# The Master EF 2026 installer is bundled at build time from this folder
# (script/build.ts inlines its clauses and exhibits), so the builder stage
# needs it. The source document is not read by anything.
!server/templates/master-ef-2026-10
server/templates/master-ef-2026-10/source.docx
.DS_Store

# Docs (not needed to build or run)
docs
*.md

# NOTE: do NOT ignore attached_assets/ — the client build imports from the
# Vite "@assets" alias, so it must remain in the build context.
