exports[`the old matrix renderer > is unchanged 1`] = `"<p style="font-weight: bold; font-size: 11pt; margin-bottom: 4px;">Exhibit C.2 — On-Site Responsibility Matrix</p><table style="width: 100%; border-collapse: collapse; margin: 12px 0; font-size: 10pt; font-family: Arial, sans-serif;"><thead><tr><th style="background-color: #3b82f6; color: #ffffff; font-weight: bold; font-size: 10pt; font-family: Arial, sans-serif; padding: 8px 12px; width: 60%; text-align: left; border-bottom: 2px solid #3b82f6; border: 1px solid #3b82f6;">Task / Responsibility</th><th style="background-color: #3b82f6; color: #ffffff; font-weight: bold; font-size: 10pt; font-family: Arial, sans-serif; padding: 8px 12px; width: 20%; text-align: center; border-bottom: 2px solid #3b82f6; border: 1px solid #3b82f6;">Company</th><th style="background-color: #3b82f6; color: #ffffff; font-weight: bold; font-size: 10pt; font-family: Arial, sans-serif; padding: 8px 12px; width: 20%; text-align: center; border-bottom: 2px solid #3b82f6; border: 1px solid #3b82f6;">Client / GC</th></tr></thead><tbody><tr><td style="background-color: #ffffff; padding: 8px 12px; font-weight: bold; text-align: left; width: 60%; border-bottom: 1px solid #dee2e6; border-left: 1px solid #dee2e6; border-right: 1px solid #dee2e6;">Site Preparation & Readiness</td><td style="background-color: #ffffff; padding: 8px 12px; font-weight: bold; text-align: center; width: 20%; border-bottom: 1px solid #dee2e6; border-left: 1px solid #dee2e6; border-right: 1px solid #dee2e6;"></td><td style="background-color: #ffffff; padding: 8px 12px; font-weight: bold; text-align: center; width: 20%; border-bottom: 1px solid #dee2e6; border-left: 1px solid #dee2e6; border-right: 1px solid #dee2e6;"></td></tr><tr><td style="background-color: #f8f9fa; padding: 8px 12px;  text-align: left; width: 60%; border-bottom: 1px solid #dee2e6; border-left: 1px solid #dee2e6; border-right: 1px solid #dee2e6;">Clearing, grading, excavation, and soil preparation</td><td style="background-color: #f8f9fa; padding: 8px 12px;  text-align: center; width: 20%; border-bottom: 1px solid #dee2e6; border-left: 1px solid #dee2e6; border-right: 1px solid #dee2e6;"></td><td style="background-color: #f8f9fa; padding: 8px 12px;  text-align: center; width: 20%; border-bottom: 1px solid #dee2e6; border-left: 1px solid #dee2e6; border-right: 1px solid #dee2e6;"><span style="font-family: 'DejaVu Sans', Arial, sans-serif; color: #1a73e8;">✓</span></td></tr><tr><td style="background-color: #ffffff; padding: 8px 12px;  text-align: left; width: 60%; border-bottom: 1px solid #dee2e6; border-left: 1px solid #dee2e6; border-right: 1px solid #dee2e6;">Foundation work (footings, slab, or crawlspace)</td><td style="background-color: #ffffff; padding: 8px 12px;  text-align: center; width: 20%; border-bottom: 1px solid #dee2e6; border-left: 1px solid #dee2e6; border-right: 1px solid #dee2e6;"></td><td style="background-color: #ffffff; padding: 8px 12px;  text-align: center; width: 20%; border-bottom: 1px solid #dee2e6; border-left: 1px solid #dee2e6; border-right: 1px solid #dee2e6;"><span style="font-family: 'DejaVu Sans', Arial, sans-serif; color: #1a73e8;">✓</span></td></tr><tr><td style="background-color: #f8f9fa; padding: 8px 12px;  text-align: left; width: 60%; border-bottom: 1px solid #dee2e6; border-left: 1px solid #dee2e6; border-right: 1px solid #dee2e6;">Underground utilities (water, sewer, electric, gas)</td><td style="background-color: #f8f9fa; padding: 8px 12px;  text-align: center; width: 20%; border-bottom: 1px solid #dee2e6; border-left: 1px solid #dee2e6; border-right: 1px solid #dee2e6;"></td><td style="background-color: #f8f9fa; padding: 8px 12px;  text-align: center; width: 20%; border-bottom: 1px solid #dee2e6; border-left: 1px solid #dee2e6; border-right: 1px solid #dee2e6;"><span style="font-family: 'DejaVu Sans', Arial, sans-serif; color: #1a73e8;">✓</span></td></tr><tr><td style="background-color: #ffffff; padding: 8px 12px;  text-a