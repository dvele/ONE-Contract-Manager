# =============================================================================
# Dvele Contract Manager - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# =============================================================================
# DATABASE (Required)
# =============================================================================

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/dvele

# =============================================================================
# SERVER
# =============================================================================

# Port the server listens on (default: 5000)
PORT=5000

# Environment mode: "development" or "production"
# In development, Vite serves the frontend with hot module replacement.
NODE_ENV=development

# Set to "true" on exactly ONE instance to run the nightly catalog sync
# (2am cron). Leave unset on all other instances when running more than one.
# ENABLE_SCHEDULED_JOBS=true

# =============================================================================
# AUTHENTICATION
# =============================================================================

# Authentication is enforced via AWS Cognito (JWT/JWKS) on every /api request.
# The frontend attaches a Bearer token from Amplify automatically, so you must
# sign in through the app to use authenticated endpoints (including in dev).
# Cognito settings are supplied via the VITE_COGNITO_* variables.

# Security key for admin sync API endpoints.
# IMPORTANT: Change this to a secure random string in production.
# If not set, a weak default is used — always override in production.
# ADMIN_SYNC_KEY=your-secure-random-string-here

# =============================================================================
# AWS S3 (Required for contract template storage)
# =============================================================================

# Bucket where uploaded .docx contract templates are stored (under templates/).
AWS_S3_BUCKET=dvele-contract-manager

# AWS region for the S3 bucket (and SDK default region).
AWS_REGION=us-west-1

# Public base URL for shared media (one-dvele-media). Reserved for serving
# public asset URLs; not used by template storage.
AWS_S3_PATH=https://one-dvele-media.s3.us-west-1.amazonaws.com/

# Credentials resolve via the default AWS chain. On AWS this is the instance/
# task IAM role. Locally, set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY or use
# an AWS profile (AWS_PROFILE).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# =============================================================================
# PDF GENERATION (Optional)
# =============================================================================

# Path to Chrome or Chromium binary for Puppeteer-based PDF generation.
# If not set, Puppeteer will attempt to find Chrome automatically.
# Examples:
#   Linux:   /usr/bin/chromium-browser
#   macOS:   /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
#   Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# =============================================================================
# PRODUCTION SYNC (Optional)
# =============================================================================

# Production database URL for the sync-to-production script.
# Only needed if running scripts/sync-to-production.ts
# PROD_DATABASE_URL=postgresql://postgres:password@prod-host:5432/dvele
